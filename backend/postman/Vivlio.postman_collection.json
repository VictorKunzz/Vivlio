{
  "info": {
    "name": "Vivlio - Backend (N2: RF01 a RF06 + extrato)",
    "description": "Colecao dos casos de teste do backend. Variaveis: baseUrl (http://localhost:8080) e token (preenchida automaticamente pelo cadastro/login).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    }

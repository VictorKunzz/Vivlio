    {
      "name": "DT-05 - Extrato de creditos (saldo = entradas - saidas)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('saldo bate com as transacoes', () => pm.expect(body.saldo).to.eql(body.totalEntradas - body.totalSaidas));",
              "pm.test('lista de transacoes', () => pm.expect(body.transacoes).to.be.an('array').with.lengthOf(body.totalEntradas + body.totalSaidas));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [

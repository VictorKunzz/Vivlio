# Copie para .env antes de rodar `docker compose up`.
# O .env e ignorado pelo git e nunca deve ser commitado.

# --- Banco ---
POSTGRES_DB=vivlio
POSTGRES_USER=vivlio
POSTGRES_PASSWORD=vivlio
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8080
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Obrigatorio: o compose se recusa a subir o backend sem este valor.
# Troque por uma chave longa e propria. Nunca reutilize esta em nada publicado.
JWT_SECRET=troque-esta-chave-de-desenvolvimento-por-uma-sua-com-pelo-menos-32-caracteres
JWT_EXPIRACAO_MS=86400000

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080
